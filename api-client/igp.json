    {
      "id": "07f215574418",
      "name": "Sismos filtrados (oct 2026, M>=4, Arequipa)",
      "method": "GET",
      "url": "{{igp_url}}/SismosReportados/MapServer/0/query",
      "description": "Filtros desde/magnitud/departamento; el día se toma en hora de Lima (05:00 UTC)",
      "params": [
        {
          "enabled": true,
          "key": "where",
          "value": "fechaevento IS NOT NULL AND fechaevento >= TIMESTAMP '2026-10-01 05:00:00' AND magnitud >= 4 AND departamento = 'AREQUIPA'"
        },
        {
          "enabled": true,
          "key": "outFields",
          "value": "code,fechaevento,magnitud,prof,profundidad,departamento,ref"
        },
        {
          "enabled": true,
          "key": "orderByFields",
          "value": "fechaevento DESC"
        },
        {
          "enabled": true,
          "key": "resultOffset",
          "value": "0"
        },
        {
          "enabled": true,
          "key": "resultRecordCount",
          "value": "20"
